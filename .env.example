# Waypoint environment variables (see docs / §16). Copy to `.env` and fill in.
# `.env` is gitignored — never commit real secrets.

# Server listen port
PORT=3000

# SQLite database + raw upload store. Defaults to ~/.waypoint/data if unset.
# WAYPOINT_DATA_DIR=/data

# Auth token. Unset = fully open (loud startup warning). Set = always enforced.
# WAYPOINT_TOKEN=

# Set the Secure flag on the web session cookie. Opt-in: the default (unset)
# supports plain-HTTP LAN / Tailscale access. Enable only when Waypoint is
# reachable exclusively over HTTPS (e.g. behind a TLS-terminating proxy).
# WAYPOINT_COOKIE_SECURE=

# Path-ingest allowlist (colon-separated). Unset = the path door is disabled.
# WAYPOINT_ALLOWED_ROOTS=

# Absolute base URL used in CLI output. Inferred if unset.
# WAYPOINT_PUBLIC_URL=

# Anthropic API key for the AI sidebar + adoptive import. Unset = features hidden.
# ANTHROPIC_API_KEY=

# Default sidebar model (changeable at runtime in /settings).
# WAYPOINT_MODEL=claude-sonnet-5
